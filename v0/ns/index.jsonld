  "@graph": [
    {
      "@id": "https://litlfred.github.io/dth-pc/v0/ns/glossary/dth-pc",
      "@type": "skos:ConceptScheme",
      "prefLabel": "Glossary of the Digital Transformation Handbook for Health Product Catalogue",
      "definition": "The handbook's own product catalogue terms, one concept per term, each quoting the handbook with its L1 page. KG concepts are written Capitalized (owner, 2026-10-31). Supply chain terms (traceability, the foundational components, order and warehouse management) are held in dth-sc, which dth-pc depends on; general digital terms (registry, interoperability, open standards, …) in smart-ra, with this handbook's wording as a cited alternative (litlfred/smart-ra#142). Every term is a candidate: only a person adopts a definition. When the smart-ra and dth-sc schemes are mounted, each term gains closeMatch/broadMatch links to the concept it narrows. Scope: the handbook does not cover medical devices (page 16); nothing here extends to them (owner, 2026-10-31, workplan Q4). Acronyms (owner, 2026-10-31): every acronym the handbook uses is a term here with the acronym as notation, unless smart-ra or dth-sc already holds it (FHIR, DHSC, WMS). Organizations several handbooks name live once in smart-ra's organizations scheme and are listed under members; organizations only this handbook names (Rwanda FDA, NAFDAC, ZAMRA, ZAMMSA, RMS, GHSC-PSM) are terms here with a foaf:focus to a W3C ORG organization (litlfred/folio-assistant-core#411).",
      "isDefinedBy": "https://litlfred.github.io/dth-pc/v0/ns/",
      "seeAlso": "../../assets/glossary/dth-pc--dth-pc.skos.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/dth-pc/v0/ns/glossary/dth-pc/product-master-data",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/dth-pc/v0/ns/glossary/dth-pc",
      "prefLabel": "Product Master Data",
      "definition": "Product master data consists of standardized information that accurately describes a health product’s characteristics. This data remains consistent across all instances of a product.",
      "isDefinedBy": "https://litlfred.github.io/dth-pc/v0/ns/",
      "seeAlso": "../../en/folio-assistant-core/glossary/instance/dth-pc/dth-pc/product-master-data/"
    },
    {
      "@id": "https://litlfred.github.io/dth-pc/v0/ns/glossary/dth-pc/transactional-data",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/dth-pc/v0/ns/glossary/dth-pc",
      "prefLabel": "Transactional Data",
      "definition": "In contrast, transactional data—such as batch numbers, manufacturing dates, and serial numbers—varies with each specific instance of the product.",
      "isDefinedBy": "https://litlfred.github.io/dth-pc/v0/ns/",
      "seeAlso": "../../en/folio-assistant-core/glossary/instance/dth-pc/dth-pc/transactional-data/"
    },
    {
      "@id": "https://litlfred.github.io/dth-pc/v0/ns/glossary/dth-pc/generic-product",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/dth-pc/v0/ns/glossary/dth-pc",
      "prefLabel": "Generic Product",
      "definition": "In this handbook, the terms ‘generic product,’ ‘product,’ or ‘product information’ pertain to the general identifying details of a health product, excluding any manufacturer-specific information.",
      "isDefinedBy": "https://litlfred.github.io/dth-pc/v0/ns/",
      "seeAlso": "../../en/folio-assistant-core/glossary/instance/dth-pc/dth-pc/generic-product/"
    },
    {
      "@id": "https://litlfred.github.io/dth-pc/v0/ns/glossary/dth-pc/trade-item",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/dth-pc/v0/ns/glossary/dth-pc",
      "prefLabel": "Trade Item",
      "definition": "Trade items are manufacturer-specific branded health products that are identifiable and unique to a particular brand or manufacturer.",
      "isDefinedBy": "https://litlfred.github.io/dth-pc/v0/ns/",
      "seeAlso": "../../en/folio-assistant-core/glossary/instance/dth-pc/dth-pc/trade-item/"
    },
    {
      "@id": "https://litlfred.github.io/dth-pc/v0/ns/glossary/dth-pc/regulated-trade-item",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/dth-pc/v0/ns/glossary/dth-pc",
      "prefLabel": "Regulated Trade Item",
      "definition": "A Regulated Trade Item represents an authorization of a Trade item within a given jurisdiction under a Product Authorization.",
      "isDefinedBy": "https://litlfred.github.io/dth-pc/v0/ns/",
      "seeAlso": "../../en/folio-assistant-core/glossary/instance/dth-pc/dth-pc/regulated-trade-item/"
    },
    {
      "@id": "https://litlfred.github.io/dth-pc/v0/ns/glossary/dth-pc/product-classification",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/dth-pc/v0/ns/glossary/dth-pc",
      "prefLabel": "Product Classification",
      "definition": "Classifications such as the anatomical therapeutic chemical classification system with defined daily doses (ATC/DDD) and the international statistical classification of diseases (ICD) categorize diseases, pathogens, or health products to assist with morbidity and mortality statistics and support healthcare decision-making.",
      "isDefinedBy": "https://litlfred.github.io/dth-pc/v0/ns/",
      "seeAlso": "../../en/folio-assistant-core/glossary/instance/dth-pc/dth-pc/product-classification/"
    },
    {
      "@id": "https://litlfred.github.io/dth-pc/v0/ns/glossary/dth-pc/national-product-catalogue",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/dth-pc/v0/ns/glossary/dth-pc",
      "prefLabel": "National Product Catalogue",
      "definition": "Adopting a suitable technology tool supports the ongoing management of product master data while maintaining consistent quality and compliance with defined standards. A widely used term for such a tool is the NPC, which many countries implement to oversee product master data.",
      "isDefinedBy": "https://litlfred.github.io/dth-pc/v0/ns/",
      "seeAlso": "../../en/folio-assistant-core/glossary/instance/dth-pc/dth-pc/national-product-catalogue/"
    },
    {
      "@id": "https://litlfred.github.io/dth-pc/v0/ns/glossary/dth-pc/country-trade-item-identifier",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/dth-pc/v0/ns/glossary/dth-pc",
      "prefLabel": "Country Trade Item Identifier",
      "definition": "This attribute is designed to default to GTINs when they are available. In the absence of GTINs, the attribute generates and maintains a local identifier, which can be replaced with a GTIN once it is assigned to the trade item.",
      "isDefinedBy": "https://litlfred.github.io/dth-pc/v0/ns/",
      "seeAlso": "../../en/folio-assistant-core/glossary/instance/dth-pc/dth-pc/country-trade-item-identifier/"
    },
    {
      "@id": "https://litlfred.github.io/dth-pc/v0/ns/glossary/dth-pc/data-owner",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/dth-pc/v0/ns/glossary/dth-pc",
      "prefLabel": "Data Owner",
      "definition": "Data owner: responsible for the overall strategy, governance, and quality of the product master data.",
      "isDefinedBy": "https://litlfred.github.io/dth-pc/v0/ns/",
      "seeAlso": "../../en/folio-assistant-core/glossary/instance/dth-pc/dth-pc/data-owner/"
    },
    {
      "@id": "https://litlfred.github.io/dth-pc/v0/ns/glossary/dth-pc/data-custodian",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/dth-pc/v0/ns/glossary/dth-pc",
      "prefLabel": "Data Custodian",
      "definition": "Data custodian: responsible for the technical management and security of product master data.",
      "isDefinedBy": "https://litlfred.github.io/dth-pc/v0/ns/",
      "seeAlso": "../../en/folio-assistant-core/glossary/instance/dth-pc/dth-pc/data-custodian/"
    },
    {
      "@id": "https://litlfred.github.io/dth-pc/v0/ns/glossary/dth-pc/data-steward",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/dth-pc/v0/ns/glossary/dth-pc",
      "prefLabel": "Data Steward",
      "definition": "Data steward: responsible for the day-to-day management, maintenance, and quality control of the product master data.",
      "isDefinedBy": "https://litlfred.github.io/dth-pc/v0/ns/",
      "seeAlso": "../../en/folio-assistant-core/glossary/instance/dth-pc/dth-pc/data-steward/"
    },
    {
      "@id": "https://litlfred.github.io/dth-pc/v0/ns/glossary/dth-pc/master-data-governance-group",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/dth-pc/v0/ns/glossary/dth-pc",
      "prefLabel": "Master Data Governance Group",
      "definition": "Establish a master data governance group composed of all relevant stakeholders to provide leadership and guidance in managing product master data additions and changes.",
      "isDefinedBy": "https://litlfred.github.io/dth-pc/v0/ns/",
      "seeAlso": "../../en/folio-assistant-core/glossary/instance/dth-pc/dth-pc/master-data-governance-group/"
    },
