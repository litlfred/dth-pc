<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_PC_BP_08"
                  targetNamespace="https://litlfred.github.io/dth-pc/bpmn">
  <bpmn:resource id="pers:pc-r-05" name="PC-R-05: Catalogue Manager" />
  <bpmn:collaboration id="Collaboration_PC_BP_08">
    <bpmn:participant id="Participant_PC_BP_08" name="PC-BP-08: Build human resource capacity to sustainably manage the NPC" processRef="Process_PC_BP_08" />
  </bpmn:collaboration>
  <bpmn:process id="Process_PC_BP_08" name="PC-BP-08: Build human resource capacity to sustainably manage the NPC" isExecutable="false">
    <bpmn:documentation>PC-BP-08: PC-BP-08: Build human resource capacity to sustainably manage the NPC (Source: who-iris/library/9789240116191-eng, page-043, page-044). FLAGGED FOR OWNER: Chapter 5 (pages 43-44) names Catalogue Manager (PC-R-05) and NPC System Administrator (PC-R-18) as target operational/technical roles, but names no performer for HR planning, budgeting, recruitment, and knowledge management; those tasks are placed in an explicit unassigned lane per workplan §2e. Data Objects: List of roles and job descriptions to support NPC (Output Step 1, p.43-44); Human resource management plan and budget (Output Step 1-2, p.43-44); Onboarded resources and Organogram (Output Step 2-3, p.44); Knowledge management plan and governmental strategy for local technical capacity (Output Step 3, p.44).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_PC_BP_08">
      <bpmn:lane id="Lane_1" name="Unassigned (flagged: Ch 5 p.43-44 names no performer for HR planning, budgeting, recruitment, and KM)">
        <bpmn:documentation>FLAGGED FOR OWNER: Chapter 5 does not name the performing role for HR capacity planning, budgeting, recruitment, and knowledge management.</bpmn:documentation>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Catalogue Manager (PC-R-05)" partitionElementRef="pers:pc-r-05">
        <bpmn:documentation>Named operational role onboarded and assigned to manage the NPC and Product Master Data processes (p.43-44)</bpmn:documentation>
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_1" name="Step 1: Identify human resource capacity needs to support NPC">
      <bpmn:documentation>Ch 5 Step 1 (p.43): Determine HR capacity required; identify operational and technical roles (e.g., Catalogue Manager, NPC System Administrator); define job descriptions and update the HR management plan.</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_2" name="Step 2a: Develop budgets, identify funding, and recruit personnel">
      <bpmn:documentation>Ch 5 Step 2 (p.44): Develop budgets, identify funding sources, and recruit and train personnel with required skill sets to fill the identified roles.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_3" name="Step 2b: Onboard and execute assigned NPC operational responsibilities">
      <bpmn:documentation>Ch 5 Step 2 (p.43-44): Onboarded Catalogue Manager (and technical staff) assume operational responsibility for the NPC according to defined job descriptions and SOPs.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_4" name="Step 3: Develop knowledge management plan and local capacity strategy">
      <bpmn:documentation>Ch 5 Step 3 (p.44): Define organogram, knowledge management plan for master data and NPC, and governmental strategy to engage and enable local vendors and technical capacity.</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="Complete">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="StartEvent_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Task_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_3" targetRef="Task_4" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_4" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_PC_BP_08">
    <bpmndi:BPMNPlane id="BPMNPlane_PC_BP_08" bpmnElement="Collaboration_PC_BP_08">
