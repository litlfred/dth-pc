<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_PC_BP_04"
                  targetNamespace="https://litlfred.github.io/dth-pc/bpmn">
  <bpmn:collaboration id="Collaboration_PC_BP_04">
    <bpmn:participant id="Participant_PC_BP_04" name="PC-BP-04: PC-BP-04: Assign a Country Trade Item Identifier and move to GTIN" processRef="Process_PC_BP_04" />
  </bpmn:collaboration>
  <bpmn:process id="Process_PC_BP_04" name="PC-BP-04: Assign a Country Trade Item Identifier and move to GTIN" isExecutable="false">
    <bpmn:documentation>PC-BP-04: PC-BP-04: Assign a Country Trade Item Identifier and move to GTIN (Source: who-iris/library/9789240116191-eng, page-039, page-040).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_PC_BP_04">
      <bpmn:lane id="Lane_1" name="Catalogue Manager (PC-R-05)">
        <bpmn:documentation>Manages product records and Country Trade Item Identifier attribute in NPC (p.39-40, 43)</bpmn:documentation>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Manufacturer / Distributor (PC-R-07)">
        <bpmn:documentation>Subscribes for and assigns globally unique trade item numbers (GTINs) to Trade Items (p.39-40)</bpmn:documentation>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="Task_1" name="Register Trade Item and evaluate GTIN availability (PC-DT-01)">
      <bpmn:documentation>Ch 4 (p.39, Fig. 13): Evaluate decision table PC-DT-01 — if GTIN is available, default Country Trade Item Identifier to the GTIN; if absent, generate and maintain a local identifier.</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:task id="Task_2" name="Subscribe for and issue GTIN for Trade Item">
      <bpmn:documentation>Ch 4 (p.39-40, Fig. 13): Manufacturer subscribes for a GS1 GTIN and provides the assigned GTIN for the Trade Item (and child packaging levels).</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:businessRuleTask id="Task_3" name="Replace local identifier with GTIN in Country Trade Item Identifier (PC-DT-01)">
      <bpmn:documentation>Ch 4 (p.39-40, Fig. 13): Replace the temporary local identifier in Country Trade Item Identifier with the newly assigned GTIN while preserving cross-reference mapping for historical transactions.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="EndEvent_1" name="Complete">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="DataObject_1" name="Trade Item record (with or without GTIN, p.39-40)" />
    <bpmn:dataObjectReference id="DataObjectRef_1" name="Trade Item record (with or without GTIN, p.39-40)" dataObjectRef="DataObject_1" />
    <bpmn:dataObject id="DataObject_2" name="Country Trade Item Identifier attribute (Fig. 13, p.40)" />
    <bpmn:dataObjectReference id="DataObjectRef_2" name="Country Trade Item Identifier attribute (Fig. 13, p.40)" dataObjectRef="DataObject_2" />
    <bpmn:sequenceFlow id="Flow_0" sourceRef="StartEvent_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Task_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_3" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_PC_BP_04">
    <bpmndi:BPMNPlane id="BPMNPlane_PC_BP_04" bpmnElement="Collaboration_PC_BP_04">
      <bpmndi:BPMNShape id="Participant_PC_BP_04_di" bpmnElement="Participant_PC_BP_04" isHorizontal="true">
        <dc:Bounds x="100" y="60" width="900" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true">
        <dc:Bounds x="130" y="60" width="870" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_2_di" bpmnElement="Lane_2" isHorizontal="true">
        <dc:Bounds x="130" y="200" width="870" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="180" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_1_di" bpmnElement="Task_1">
        <dc:Bounds x="260" y="90" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_2_di" bpmnElement="Task_2">
        <dc:Bounds x="450" y="230" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_3_di" bpmnElement="Task_3">
        <dc:Bounds x="640" y="90" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="830" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0">
        <di:waypoint x="216" y="130" />
        <di:waypoint x="260" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="400" y="130" />
        <di:waypoint x="450" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="590" y="270" />
        <di:waypoint x="640" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="780" y="130" />
        <di:waypoint x="830" y="130" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
