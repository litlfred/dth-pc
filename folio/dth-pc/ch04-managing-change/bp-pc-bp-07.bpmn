<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_PC_BP_07"
                  targetNamespace="https://litlfred.github.io/dth-pc/bpmn">
  <bpmn:collaboration id="Collaboration_PC_BP_07">
    <bpmn:participant id="Participant_PC_BP_07" name="PC-BP-07: PC-BP-07: Institutionalise use of the National Product Catalogue: change plan and SOPs" processRef="Process_PC_BP_07" />
  </bpmn:collaboration>
  <bpmn:process id="Process_PC_BP_07" name="PC-BP-07: Institutionalise use of the National Product Catalogue: change plan and SOPs" isExecutable="false">
    <bpmn:documentation>PC-BP-07: PC-BP-07: Institutionalise use of the National Product Catalogue: change plan and SOPs (Source: who-iris/library/9789240116191-eng, page-039, page-040, page-041). FLAGGED FOR OWNER: Chapter 4 (pages 39-41) names no performer for Steps 1-2; all tasks are placed in an explicit unassigned lane per workplan §2e.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_PC_BP_07">
      <bpmn:lane id="Lane_1" name="Unassigned (flagged: Ch 4 p.39-41 names no performer)">
        <bpmn:documentation>FLAGGED FOR OWNER: Chapter 4 states Steps 1-2 without naming a performing role.</bpmn:documentation>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_1" name="Step 1: Develop a change management plan to institutionalise use of NPC">
      <bpmn:documentation>Ch 4 Step 1 (p.39): Identify all systems and processes needing standardized Product Master Data; define process changes, system enhancements, data model changes, and event-triggered exchange mechanisms.</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_2" name="Step 2: Define SOPs to collect, organize and manage Product Master Data and train users">
      <bpmn:documentation>Ch 4 Step 2 (p.40-41): Define, validate, and approve SOPs for NPC workflows; define and institutionalize a continuous training and advocacy plan; train users on the approved SOPs.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="Complete">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="DataObject_1" name="Change management plan for all systems and processes to use NPC (Output Step 1, p.39)" />
    <bpmn:dataObjectReference id="DataObjectRef_1" name="Change management plan for all systems and processes to use NPC (Output Step 1, p.39)" dataObjectRef="DataObject_1" />
    <bpmn:dataObject id="DataObject_2" name="Product Master Data management SOPs (Output Step 2, p.40-41)" />
    <bpmn:dataObjectReference id="DataObjectRef_2" name="Product Master Data management SOPs (Output Step 2, p.40-41)" dataObjectRef="DataObject_2" />
    <bpmn:dataObject id="DataObject_3" name="Continuous training plan (Output Step 2, p.40-41)" />
    <bpmn:dataObjectReference id="DataObjectRef_3" name="Continuous training plan (Output Step 2, p.40-41)" dataObjectRef="DataObject_3" />
    <bpmn:sequenceFlow id="Flow_0" sourceRef="StartEvent_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Task_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_2" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_PC_BP_07">
    <bpmndi:BPMNPlane id="BPMNPlane_PC_BP_07" bpmnElement="Collaboration_PC_BP_07">
      <bpmndi:BPMNShape id="Participant_PC_BP_07_di" bpmnElement="Participant_PC_BP_07" isHorizontal="true">
        <dc:Bounds x="100" y="60" width="956" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true">
        <dc:Bounds x="130" y="60" width="926" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="180" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_1_di" bpmnElement="Task_1">
        <dc:Bounds x="256" y="90" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_2_di" bpmnElement="Task_2">
        <dc:Bounds x="476" y="75" width="180" height="110" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="696" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0">
        <di:waypoint x="216" y="130" />
        <di:waypoint x="256" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="436" y="130" />
        <di:waypoint x="476" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="656" y="130" />
        <di:waypoint x="696" y="130" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
