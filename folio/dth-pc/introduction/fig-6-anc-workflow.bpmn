  <bpmn:category id="Category_ANC"><bpmn:categoryValue id="CV_ANC_assessment" value="ANC assessment" /></bpmn:category>
  <bpmn:collaboration id="Collaboration_Fig_6">
    <bpmn:participant id="Participant_Fig_6" name="Antenatal care contact" processRef="Process_Fig_6" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Fig_6" name="Example of an Antenatal Care Business clinical workflow with highlighted connections to supply chain" isExecutable="false">
    <bpmn:documentation>DTH PC Fig. 6 (PDF page 15), transcribed element by element from the figure, which the handbook reproduces from the Digital Adaptation Kit for Antenatal Care: Operational requirements for implementing WHO recommendations in digital systems. Tasks 9, 10.5, 10.7 and 10.9 carry the figure's highlight (connections to supply chain). The figure's enlarged inset of tasks 6 to 10 repeats the same elements and is not drawn twice. Source PNG: who-iris/library/9789240116191-eng/figures/vfig-p015.png.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Fig_6">
      <bpmn:lane id="Lane_Client" name="Client">
        <bpmn:documentation>The pregnant woman attending antenatal care: the Client lane of DTH PC Fig. 6 (p. 15), reproduced from the ANC Digital Adaptation Kit.</bpmn:documentation>
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Arrive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HF" name="Health facility">
        <bpmn:documentation>The health facility where the contact takes place: the Health facility lane of DTH PC Fig. 6 (p. 15), reproduced from the ANC Digital Adaptation Kit.</bpmn:documentation>
        <bpmn:childLaneSet id="LaneSet_HF">
          <bpmn:lane id="Lane_HW" name="Health worker">
            <bpmn:documentation>The health worker at the facility: the Health worker lane of DTH PC Fig. 6 (p. 15), reproduced from the ANC Digital Adaptation Kit.</bpmn:documentation>
            <bpmn:flowNodeRef>SP_A</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>T_1</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>GW_2</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>End_C1</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>GW_3</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>End_SRH</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>GW_4</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>T_5</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>T_6</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>T_7</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>T_8</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>T_9</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>SP_10</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>T_10_1</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>T_10_2</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>T_10_3</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>T_10_4</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>T_10_5</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>T_10_6</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>T_10_7</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>T_10_8</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>T_10_9</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>GW_11</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>End_C2</bpmn:flowNodeRef>
            <bpmn:flowNodeRef>T_12</bpmn:flowNodeRef>
          </bpmn:lane>
        </bpmn:childLaneSet>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Start">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_Arrive" name="Arrive at facility">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="SP_A" name="A. Registration">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:task id="T_1" name="1. Rapid assessment and management (RAM)">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_2" name="2. Danger signs needing referral?">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_C1" name="C. Antenatal care (ANC) referral">
      <bpmn:incoming>F5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_3" name="3. Confirm pregnancy">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_SRH" name="Refer to other sexual and reproductive health services">
      <bpmn:incoming>F7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_4" name="4. First contact?">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_5" name="5. Quick check">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:businessRuleTask id="T_6" name="6. Collect woman's profile and history">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="T_7" name="7. Check symptoms and follow-up">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="T_8" name="8. Conduct physical exam">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="T_9" name="9. Conduct laboratory tests and imaging">
      <bpmn:documentation>Highlighted in the source figure: a connection to the supply chain.</bpmn:documentation>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:adHocSubProcess id="SP_10" name="10. Counselling, in-facility management and treatment" ordering="Parallel">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
      <bpmn:businessRuleTask id="T_10_1" name="10.1 Behaviour counselling" />
      <bpmn:businessRuleTask id="T_10_2" name="10.2 Physiological symptoms counselling" />
      <bpmn:businessRuleTask id="T_10_3" name="10.3 Diet counselling" />
      <bpmn:businessRuleTask id="T_10_4" name="10.4 Diagnosis and treatment" />
      <bpmn:businessRuleTask id="T_10_5" name="10.5 Nutrition supplementation">
        <bpmn:documentation>Highlighted in the source figure: a connection to the supply chain.</bpmn:documentation>
      </bpmn:businessRuleTask>
      <bpmn:businessRuleTask id="T_10_6" name="10.6 Risk reduction and general counselling" />
      <bpmn:businessRuleTask id="T_10_7" name="10.7 Immunizations">
        <bpmn:documentation>Highlighted in the source figure: a connection to the supply chain.</bpmn:documentation>
      </bpmn:businessRuleTask>
      <bpmn:businessRuleTask id="T_10_8" name="10.8 Intimate partner violence counselling" />
      <bpmn:businessRuleTask id="T_10_9" name="10.9 Deworming and malaria counselling and prophylaxis">
        <bpmn:documentation>Highlighted in the source figure: a connection to the supply chain.</bpmn:documentation>
      </bpmn:businessRuleTask>
    </bpmn:adHocSubProcess>
    <bpmn:exclusiveGateway id="GW_11" name="11. Referral needed?">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_C2" name="C. ANC referral">
      <bpmn:incoming>F17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_12" name="12. Scheduling">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_13" name="13. Self-care in the home or community">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_14" name="14. Woman returns?">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End" name="End">
      <bpmn:incoming>F21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T_Arrive" />
    <bpmn:sequenceFlow id="F2" sourceRef="T_Arrive" targetRef="SP_A" />
    <bpmn:sequenceFlow id="F3" sourceRef="SP_A" targetRef="T_1" />
