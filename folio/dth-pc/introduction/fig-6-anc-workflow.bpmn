    <bpmn:sequenceFlow id="F18" name="No" sourceRef="GW_11" targetRef="T_12" />
    <bpmn:sequenceFlow id="F19" sourceRef="T_12" targetRef="T_13" />
    <bpmn:sequenceFlow id="F20" sourceRef="T_13" targetRef="GW_14" />
    <bpmn:sequenceFlow id="F21" name="No" sourceRef="GW_14" targetRef="End" />
    <bpmn:sequenceFlow id="F22" name="Yes" sourceRef="GW_14" targetRef="T_Arrive" />
    <bpmn:group id="Group_ANC_assessment" categoryValueRef="CV_ANC_assessment" />
  </bpmn:process>
