<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_PC_BP_09"
                  targetNamespace="https://litlfred.github.io/dth-pc/bpmn">
  <bpmn:resource id="pers:pc-r-09" name="PC-R-09: WHO User Group and Country User Group" />
  <bpmn:collaboration id="Collaboration_PC_BP_09">
    <bpmn:participant id="Participant_PC_BP_09" name="PC-BP-09: Derive a country catalogue from the Global Catalogue (associate or copy a product)" processRef="Process_PC_BP_09" />
  </bpmn:collaboration>
  <bpmn:process id="Process_PC_BP_09" name="PC-BP-09: Derive a country catalogue from the Global Catalogue (associate or copy a product)" isExecutable="false">
    <bpmn:documentation>PC-BP-09: PC-BP-09: Derive a country catalogue from the Global Catalogue (associate or copy a product) (Source: who-iris/library/9789240116191-eng, page-046, page-047).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_PC_BP_09">
      <bpmn:lane id="Lane_1" name="WHO User Group (PC-R-09: WHOGroup)" partitionElementRef="pers:pc-r-09">
        <bpmn:documentation>Manages, edits, and owns product records in the Global Catalogue (Catalogues -&gt; WHO, p.46-47)</bpmn:documentation>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Country User Group (PC-R-09: Country Group)" partitionElementRef="pers:pc-r-09">
        <bpmn:documentation>Views Global Catalogue and edits/owns product records in the Country Catalogue (Catalogues -&gt; Country, p.46-47)</bpmn:documentation>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="Task_1" name="Maintain common product information in the Global Catalogue (PC-DT-02)">
      <bpmn:documentation>Ch 6 (p.46-47, Fig. 14): WHOGroup publishes common product attributes in the Global Catalogue (global identifier, Unit of Use, pharmaceutical information, Trade Item information, manufacturer, country of origin, shelf life) per PC-DT-02.</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:task id="Task_2" name="Associate or copy product record from Global Catalogue into Country Catalogue">
      <bpmn:documentation>Ch 6 (p.46-47, Fig. 14): Country user selects designated Country Catalogue category and either associates a country product with a Global Catalogue product or copies Trade Item data from the Global Catalogue via manual or automated copy rules.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:businessRuleTask id="Task_3" name="Add country-specific product attributes and approve record (PC-DT-02)">
      <bpmn:documentation>Ch 6 (p.46-47, Fig. 14): Country user populates country-specific attributes (country identifiers, national registration number per PC-DT-02) and approves the record in the Country Catalogue.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="EndEvent_1" name="Complete">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="DataObject_1" name="Global Catalogue product record (common product and Trade Item information, Fig. 14, p.46)" />
    <bpmn:dataObjectReference id="DataObjectRef_1" name="Global Catalogue product record (common product and Trade Item information, Fig. 14, p.46)" dataObjectRef="DataObject_1" />
    <bpmn:dataObject id="DataObject_2" name="Country Catalogue product record (linked/derived common attributes + country identifiers and registration number, Fig. 14, p.46)" />
    <bpmn:dataObjectReference id="DataObjectRef_2" name="Country Catalogue product record (linked/derived common attributes + country identifiers and registration number, Fig. 14, p.46)" dataObjectRef="DataObject_2" />
    <bpmn:sequenceFlow id="Flow_0" sourceRef="StartEvent_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Task_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_3" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_PC_BP_09">
    <bpmndi:BPMNPlane id="BPMNPlane_PC_BP_09" bpmnElement="Collaboration_PC_BP_09">
      <bpmndi:BPMNShape id="Participant_PC_BP_09_di" bpmnElement="Participant_PC_BP_09" isHorizontal="true">
        <dc:Bounds x="100" y="60" width="986" height="396" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true">
        <dc:Bounds x="130" y="60" width="956" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_2_di" bpmnElement="Lane_2" isHorizontal="true">
        <dc:Bounds x="130" y="200" width="956" height="256" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="180" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_1_di" bpmnElement="Task_1">
        <dc:Bounds x="256" y="90" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_2_di" bpmnElement="Task_2">
        <dc:Bounds x="476" y="288" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_3_di" bpmnElement="Task_3">
        <dc:Bounds x="696" y="288" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="916" y="310" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0">
        <di:waypoint x="216" y="130" />
        <di:waypoint x="256" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="436" y="130" />
        <di:waypoint x="456" y="130" />
        <di:waypoint x="456" y="328" />
        <di:waypoint x="476" y="328" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="656" y="328" />
        <di:waypoint x="696" y="328" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="876" y="328" />
        <di:waypoint x="916" y="328" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
