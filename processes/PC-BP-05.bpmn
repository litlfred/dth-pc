<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_PC_BP_05"
                  targetNamespace="https://litlfred.github.io/dth-pc/bpmn">
  <bpmn:resource id="pers:pc-r-05" name="PC-R-05: Catalogue Manager" />
  <bpmn:collaboration id="Collaboration_PC_BP_05">
    <bpmn:participant id="Participant_PC_BP_05" name="PC-BP-05: Distribute Product Master Data to downstream systems on add or update" processRef="Process_PC_BP_05" />
  </bpmn:collaboration>
  <bpmn:process id="Process_PC_BP_05" name="PC-BP-05: Distribute Product Master Data to downstream systems on add or update" isExecutable="false">
    <bpmn:documentation>PC-BP-05: PC-BP-05: Distribute Product Master Data to downstream systems on add or update (Source: who-iris/library/9789240116191-eng, page-031, page-039). Data Objects: Standardized Product Master Data update payload (p.39); Data sharing policies and exchange protocols (p.31, 39).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_PC_BP_05">
      <bpmn:lane id="Lane_1" name="Catalogue Manager / NPC (PC-R-05)" partitionElementRef="pers:pc-r-05">
        <bpmn:documentation>Publishes Product Master Data additions and updates from the NPC (p.39)</bpmn:documentation>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Consuming Supply Chain Systems (eLMIS, WMS, Procurement, OMS)">
        <bpmn:documentation>Downstream health and supply chain information systems receiving standardized Product Master Data via DPI-F Information Mediator (p.16, 31, 39)</bpmn:documentation>
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_1" name="Trigger Product Master Data exchange event on add or update">
      <bpmn:documentation>Ch 4 Step 1 (p.39): Emit Product Master Data exchange event from NPC when a product record is added or updated.</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_2" name="Route standardized Product Master Data through Information Mediator">
      <bpmn:documentation>Intro (p.16), Ch 2 Step 3 (p.31) &amp; Ch 4 Step 1 (p.39): Distribute standardized Product Master Data attributes according to data sharing agreements and security protocols.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_3" name="Receive, store, and use standardized Product Master Data in transactions">
      <bpmn:documentation>Ch 4 Step 1 (p.39): Consuming systems (eLMIS, WMS, procurement, OMS, dispensing) ingest standardized Product Master Data and reference uniform identifiers across forecasting, procurement, inventory, shipping, dispensing, and traceability.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="Complete">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="StartEvent_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Task_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_3" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_PC_BP_05">
    <bpmndi:BPMNPlane id="BPMNPlane_PC_BP_05" bpmnElement="Collaboration_PC_BP_05">
      <bpmndi:BPMNShape id="Participant_PC_BP_05_di" bpmnElement="Participant_PC_BP_05" isHorizontal="true">
        <dc:Bounds x="100" y="60" width="950" height="446" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true">
        <dc:Bounds x="130" y="60" width="920" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_2_di" bpmnElement="Lane_2" isHorizontal="true">
        <dc:Bounds x="130" y="200" width="920" height="306" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="180" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_1_di" bpmnElement="Task_1">
        <dc:Bounds x="260" y="90" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_2_di" bpmnElement="Task_2">
        <dc:Bounds x="440" y="90" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_3_di" bpmnElement="Task_3">
        <dc:Bounds x="660" y="313" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="880" y="335" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0">
        <di:waypoint x="216" y="130" />
        <di:waypoint x="260" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="400" y="130" />
        <di:waypoint x="440" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="620" y="130" />
        <di:waypoint x="640" y="130" />
        <di:waypoint x="640" y="353" />
        <di:waypoint x="660" y="353" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="840" y="353" />
        <di:waypoint x="880" y="353" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
