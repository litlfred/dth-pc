<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_PC_BP_10"
                  targetNamespace="https://litlfred.github.io/dth-pc/bpmn">
  <bpmn:collaboration id="Collaboration_PC_BP_10">
    <bpmn:participant id="Participant_PC_BP_10" name="PC-BP-10: Share country Product Master Data with the WHO Global Catalogue" processRef="Process_PC_BP_10" />
  </bpmn:collaboration>
  <bpmn:process id="Process_PC_BP_10" name="PC-BP-10: Share country Product Master Data with the WHO Global Catalogue" isExecutable="false">
    <bpmn:documentation>PC-BP-10: PC-BP-10: Share country Product Master Data with the WHO Global Catalogue (Source: who-iris/library/9789240116191-eng, page-049, page-050).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_PC_BP_10">
      <bpmn:lane id="Lane_1" name="Country User Group (PC-R-09: WHO-hosted PCMT or in-country NPC tool)">
        <bpmn:documentation>Country sharing national Product Master Data with the WHO Global Product Catalogue (p.49-50, Fig. 15)</bpmn:documentation>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="WHO User Group (PC-R-09: WHO Global Product Catalogue)">
        <bpmn:documentation>Aggregates, harmonizes, and publishes shared Product Master Data in the Global Catalogue as a global good (p.49-50, Fig. 15)</bpmn:documentation>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_1" name="Submit national Product Master Data to WHO Global Catalogue">
      <bpmn:documentation>Ch 7 (p.49-50, Fig. 15): Country (using either the WHO-hosted PCMT instance or an in-country NPC tool) shares standardized Product Master Data with the WHO Global Product Catalogue.</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_2" name="Aggregate and harmonize shared Product Master Data across sources">
      <bpmn:documentation>Ch 7 (p.49-50, Fig. 15): WHO Global Catalogue aggregates Product Master Data from multiple countries and sources and harmonizes differences to support global standardization.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_3" name="Publish harmonized Product Master Data in Global Catalogue for reuse by countries">
      <bpmn:documentation>Ch 7 (p.49-50, Fig. 15): Publish updated Global Catalogue records so participating and other countries can access accurate product information and reduce duplication.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="Complete">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="DataObject_1" name="Shared national Product Master Data submission (Fig. 15, p.49-50)" />
    <bpmn:dataObjectReference id="DataObjectRef_1" name="Shared national Product Master Data submission (Fig. 15, p.49-50)" dataObjectRef="DataObject_1" />
    <bpmn:dataObject id="DataObject_2" name="Harmonized WHO Global Product Catalogue dataset (Fig. 15, p.49-50)" />
    <bpmn:dataObjectReference id="DataObjectRef_2" name="Harmonized WHO Global Product Catalogue dataset (Fig. 15, p.49-50)" dataObjectRef="DataObject_2" />
    <bpmn:sequenceFlow id="Flow_0" sourceRef="StartEvent_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Task_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_3" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_PC_BP_10">
    <bpmndi:BPMNPlane id="BPMNPlane_PC_BP_10" bpmnElement="Collaboration_PC_BP_10">
      <bpmndi:BPMNShape id="Participant_PC_BP_10_di" bpmnElement="Participant_PC_BP_10" isHorizontal="true">
        <dc:Bounds x="100" y="60" width="950" height="598" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true">
        <dc:Bounds x="130" y="60" width="920" height="316" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_2_di" bpmnElement="Lane_2" isHorizontal="true">
        <dc:Bounds x="130" y="376" width="920" height="282" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="180" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_1_di" bpmnElement="Task_1">
        <dc:Bounds x="260" y="178" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_2_di" bpmnElement="Task_2">
        <dc:Bounds x="440" y="477" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_3_di" bpmnElement="Task_3">
        <dc:Bounds x="660" y="477" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="880" y="499" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0">
        <di:waypoint x="216" y="218" />
        <di:waypoint x="260" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="400" y="218" />
        <di:waypoint x="420" y="218" />
        <di:waypoint x="420" y="517" />
        <di:waypoint x="440" y="517" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="620" y="517" />
        <di:waypoint x="660" y="517" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="840" y="517" />
        <di:waypoint x="880" y="517" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
