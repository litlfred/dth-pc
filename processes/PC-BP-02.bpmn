<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_PC_BP_02"
                  targetNamespace="https://litlfred.github.io/dth-pc/bpmn">
  <bpmn:collaboration id="Collaboration_PC_BP_02">
    <bpmn:participant id="Participant_PC_BP_02" name="PC-BP-02: Establish master data management and governance" processRef="Process_PC_BP_02" />
  </bpmn:collaboration>
  <bpmn:process id="Process_PC_BP_02" name="PC-BP-02: Establish master data management and governance" isExecutable="false">
    <bpmn:documentation>PC-BP-02: PC-BP-02: Establish master data management and governance (Source: who-iris/library/9789240116191-eng, page-025, page-026, page-027, page-028, page-029, page-030, page-031, page-032, page-033).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_PC_BP_02">
      <bpmn:lane id="Lane_1" name="Data Owner (PC-R-01)">
        <bpmn:documentation>Overall strategy, governance, and quality of Product Master Data (p.26)</bpmn:documentation>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Data Steward (PC-R-03)">
        <bpmn:documentation>Day-to-day management, maintenance, harmonization, and quality control (p.26-27)</bpmn:documentation>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Data Custodian (PC-R-02)">
        <bpmn:documentation>Technical management, security protocols, and access controls (p.26, 31-32)</bpmn:documentation>
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="Master Data Governance Group (PC-R-04)">
        <bpmn:documentation>Stakeholder governance group providing leadership and oversight (p.25, 32)</bpmn:documentation>
        <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_1" name="Step 1: Define Product Master Data management procedures">
      <bpmn:documentation>Ch 2 Step 1 (p.25-26): Review current product coding schemes and datasets; evaluate harmonization needs; develop master data management procedures and TOR for the Master Data Governance Group.</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_2" name="Step 2: Define coding scheme, data definitions and structures">
      <bpmn:documentation>Ch 2 Step 2 (p.27-30): Conduct data harmonization; establish standardized coding schemes and structures for Product Classification, Generic Product, Trade Item, Regulated Trade Item, and Packaging Hierarchy; map to HL7 FHIR, ISO IDMP, WHODrug, and GS1 GTIN.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_3" name="Step 3: Define data use policies and data sharing mechanisms">
      <bpmn:documentation>Ch 2 Step 3 (p.31): Identify all master data sources and consumers; define data use policies, data sharing agreements, exchange mechanisms, and security/sensitivity protocols.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_4" name="Step 4: Institutionalise Product Master Data governance policies and procedures">
      <bpmn:documentation>Ch 2 Step 4 (p.32): Establish the Master Data Governance Group and integrate master data management procedures, coding schemes, and governance policies across health supply chain operations.</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_5" name="Step 5: Define short- and long-term strategies to source standardized Product Master Data">
      <bpmn:documentation>Ch 2 Step 5 (p.33): Define short/medium-term sourcing (procurement agencies, donors, product packaging) and long-term sustainable sourcing (formal submission during regulatory product registration).</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="Complete">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="DataObject_1" name="Endorsed master data policies and legislations (Input from Ch 1, p.25, 33)" />
    <bpmn:dataObjectReference id="DataObjectRef_1" name="Endorsed master data policies and legislations (Input from Ch 1, p.25, 33)" dataObjectRef="DataObject_1" />
    <bpmn:dataObject id="DataObject_2" name="Master data management procedures and TOR for Master Data Governance Group (Output Step 1, p.25)" />
    <bpmn:dataObjectReference id="DataObjectRef_2" name="Master data management procedures and TOR for Master Data Governance Group (Output Step 1, p.25)" dataObjectRef="DataObject_2" />
    <bpmn:dataObject id="DataObject_3" name="Standardized master data coding schemes and structures (Output Step 2, p.27)" />
    <bpmn:dataObjectReference id="DataObjectRef_3" name="Standardized master data coding schemes and structures (Output Step 2, p.27)" dataObjectRef="DataObject_3" />
    <bpmn:dataObject id="DataObject_4" name="Data sharing and data use policies (Output Step 3, p.31)" />
    <bpmn:dataObjectReference id="DataObjectRef_4" name="Data sharing and data use policies (Output Step 3, p.31)" dataObjectRef="DataObject_4" />
    <bpmn:dataObject id="DataObject_5" name="Short-term and long-term strategies for sourcing master data (Output Step 5, p.33)" />
    <bpmn:dataObjectReference id="DataObjectRef_5" name="Short-term and long-term strategies for sourcing master data (Output Step 5, p.33)" dataObjectRef="DataObject_5" />
    <bpmn:sequenceFlow id="Flow_0" sourceRef="StartEvent_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Task_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_3" targetRef="Task_4" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_4" targetRef="Task_5" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_5" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_PC_BP_02">
    <bpmndi:BPMNPlane id="BPMNPlane_PC_BP_02" bpmnElement="Collaboration_PC_BP_02">
      <bpmndi:BPMNShape id="Participant_PC_BP_02_di" bpmnElement="Participant_PC_BP_02" isHorizontal="true">
