<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_PC_BP_06"
                  targetNamespace="https://litlfred.github.io/dth-pc/bpmn">
  <bpmn:collaboration id="Collaboration_PC_BP_06">
    <bpmn:participant id="Participant_PC_BP_06" name="PC-BP-06: Select, plan and deploy the National Product Catalogue tool" processRef="Process_PC_BP_06" />
  </bpmn:collaboration>
  <bpmn:process id="Process_PC_BP_06" name="PC-BP-06: Select, plan and deploy the National Product Catalogue tool" isExecutable="false">
    <bpmn:documentation>PC-BP-06: PC-BP-06: Select, plan and deploy the National Product Catalogue tool (Source: who-iris/library/9789240116191-eng, page-035, page-036, page-037). FLAGGED FOR OWNER: Chapter 3 (pages 35-37) names no performer for Steps 1-4; all tasks are placed in an explicit unassigned lane per workplan §2e.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_PC_BP_06">
      <bpmn:lane id="Lane_1" name="Unassigned (flagged: Ch 3 p.35-37 names no performer)">
        <bpmn:documentation>FLAGGED FOR OWNER: Chapter 3 states the 4 technology steps in the passive/imperative voice without naming performing roles. (Introduction p.18 lists illustrative target users, and Annex 2 p.57-61 lists typical implementation roles PC-R-10..19.)</bpmn:documentation>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_1" name="Step 1: Define functional and non-functional system requirements for the NPC tool">
      <bpmn:documentation>Ch 3 Step 1 (p.35): Define functional and non-functional requirements considering coding schemes, data structures, master data management procedures, and data sharing policies; review with stakeholders and facilitate approval.</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_2" name="Step 2: Identify technology options and select the appropriate tool">
      <bpmn:documentation>Ch 3 Step 2 (p.36): Conduct market research (RFI), assess existing tools and open-source options (such as PCMT or WHO-hosted PCMT), and conduct RFQ/RFP if necessary to select the NPC tool.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_3" name="Step 3: Prepare a plan to implement the NPC tool and integrate with other systems">
      <bpmn:documentation>Ch 3 Step 3 (p.36): Develop a detailed NPC implementation project plan to design, configure, deploy, and integrate the chosen tool; review with stakeholders and initiate the project.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_4" name="Step 4: Design, develop, validate, and deploy the NPC tool">
      <bpmn:documentation>Ch 3 Step 4 (p.37): Design configurations, build integrations, perform system/integration/performance testing and UAT, set up infrastructure, load available Product Master Data, and deploy the NPC tool.</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="Complete">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="DataObject_1" name="Approved functional and non-functional system requirements for NPC (Output Step 1, p.35)" />
    <bpmn:dataObjectReference id="DataObjectRef_1" name="Approved functional and non-functional system requirements for NPC (Output Step 1, p.35)" dataObjectRef="DataObject_1" />
    <bpmn:dataObject id="DataObject_2" name="Selection of an appropriate technology tool for NPC (Output Step 2, p.36)" />
    <bpmn:dataObjectReference id="DataObjectRef_2" name="Selection of an appropriate technology tool for NPC (Output Step 2, p.36)" dataObjectRef="DataObject_2" />
    <bpmn:dataObject id="DataObject_3" name="NPC implementation project plan (Output Step 3, p.36)" />
    <bpmn:dataObjectReference id="DataObjectRef_3" name="NPC implementation project plan (Output Step 3, p.36)" dataObjectRef="DataObject_3" />
    <bpmn:dataObject id="DataObject_4" name="NPC system design specifications, validation report, and deployed NPC tool (Output Step 4, p.37)" />
    <bpmn:dataObjectReference id="DataObjectRef_4" name="NPC system design specifications, validation report, and deployed NPC tool (Output Step 4, p.37)" dataObjectRef="DataObject_4" />
    <bpmn:sequenceFlow id="Flow_0" sourceRef="StartEvent_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Task_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_3" targetRef="Task_4" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_4" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_PC_BP_06">
    <bpmndi:BPMNPlane id="BPMNPlane_PC_BP_06" bpmnElement="Collaboration_PC_BP_06">
      <bpmndi:BPMNShape id="Participant_PC_BP_06_di" bpmnElement="Participant_PC_BP_06" isHorizontal="true">
        <dc:Bounds x="100" y="60" width="1176" height="351" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true">
        <dc:Bounds x="130" y="60" width="1146" height="351" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="180" y="217.5" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_1_di" bpmnElement="Task_1">
        <dc:Bounds x="256" y="180.5" width="180" height="110" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_2_di" bpmnElement="Task_2">
        <dc:Bounds x="476" y="195.5" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_3_di" bpmnElement="Task_3">
        <dc:Bounds x="696" y="195.5" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_4_di" bpmnElement="Task_4">
        <dc:Bounds x="916" y="195.5" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1136" y="217.5" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0">
        <di:waypoint x="216" y="235.5" />
        <di:waypoint x="256" y="235.5" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="436" y="235.5" />
        <di:waypoint x="476" y="235.5" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="656" y="235.5" />
        <di:waypoint x="696" y="235.5" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="876" y="235.5" />
        <di:waypoint x="916" y="235.5" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="1096" y="235.5" />
