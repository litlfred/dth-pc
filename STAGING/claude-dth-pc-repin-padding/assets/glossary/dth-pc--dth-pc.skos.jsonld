    },
    {
      "@id": "https://litlfred.github.io/dth-pc/v0/ns#glossary/dth-pc/product-master-data",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-pc/v0/ns#glossary/dth-pc"
      },
      "skos:prefLabel": [
        {
          "@value": "Product Master Data"
        }
      ],
      "skos:altLabel": [
        "product master data",
        "PMD"
      ],
      "skos:definition": [
        {
          "@value": "Product master data consists of standardized information that accurately describes a health product’s characteristics. This data remains consistent across all instances of a product."
        }
      ],
      "skos:scopeNote": "Handbook wording, quoted. A candidate: not adopted, nothing chosen between alternatives. Examples the handbook gives: product description, dosage, pharmaceutical strength, manufacturer details, shelf life. Owner, 2026-10-31: one concept, no homonym split with the RA's 'Product'. Not defined in dth-sc; this handbook is its source.",
