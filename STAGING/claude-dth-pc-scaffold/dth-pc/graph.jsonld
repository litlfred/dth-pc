d.github.io/dth-pc/v0/ns#glossary/dth-pc/product-master-data","prefLabel":"Product Master Data"}],"archimate":{"model":"smart-ra 0.3.0-draft.1","basis":"agent-proposed by name and figure mapping, for working-group review (dth-pc#2 PC-6, smart-ra#147)","elements":[{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-bb1fc1b7425444ed8a0c420bec960edd.jsonld","name":"Product Catalog Management System"},{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-ed45b0d35d7c5ccbbf4abe599a80be5c.jsonld","name":"National Product Catalogue"},{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-48ca7ae8d2ed5a5a992fbdd0528f9fe8.jsonld","name":"Generic Product"},{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-60e7d1d9e64c5011a1efe8becac406d0.jsonld","name":"Trade Item"},{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-b99b159bb8d558ef8477825142fe4700.jsonld","name":"Regulated Trade Item"},{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-815bef20a55f5f59b409a76a9a6545f8.jsonld","name":"Product Master Data"}],"views":[{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/views/id-02175c6feb9155618981ff120f954420.jsonld","name":"National Product Catalogue (DTH PC Fig. 2, Ch. 2-3)"}]}},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-pc/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-pc/blocks/pers-pc-r-09","@type":["smart-base:Persona"],"label":"pers:pc-r-09","kind":"persona","title":"PC-R-09: WHO User Group and Country User Group","text":"pers-pc-r-09.md","meta":{"title":"PC-R-09: WHO User Group and Country User Group","roleId":"PC-R-09","personaType":"catalogue-user-group","processes":["PC-BP-09","PC-BP-10"],"responsibilities":["WHO User Group (WHOGroup): manages, edits, and owns (approves/rejects) product records in the Global Catalogue category (Catalogues -> WHO), which all users have permission to view.","Country User Group (e.g., CAGroup, CBGroup): views, edits, and owns (approves/rejects) product records in its designated Country Catalogue category (Catalogues -> CA, Catalogues -> CB).","Country User Group: associates country catalogue products with Global Catalogue products or copies Trade Item data from the Global Catalogue into the national catalogue (Fig. 14).","Country User Group (WHO-hosted PCMT or in-country NPC tool): shares national Product Master Data back to the WHO Global Product Catalogue as a global good (Fig. 15)."],"source":{"library":"9789240116191-eng","section":"page-046, page-047, page-049, page-050","file":"who-iris/library/9789240116191-eng/sections/page-047.md","pdfPage":47,"method":"pc8-role-extraction"},"glossary":[{"iri":"https://litlfred.github.io/dth-pc/v0/ns#glossary/dth-pc/product-catalogue-management-tool","prefLabel":"Product Catalogue Management Tool"},{"iri":"https://litlfred.github.io/dth-pc/v0/ns#glossary/dth-pc/national-product-catalogue","prefLabel":"National Product Catalogue"},{"iri":"https://litlfred.github.io/dth-pc/v0/ns#glossary/dth-pc/product-master-data","prefLabel":"Product Master Data"},{"iri":"https://litlfred.github.io/dth-pc/v0/ns#glossary/dth-pc/trade-item","prefLabel":"Trade Item"},{"iri":"https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/stakeholder","prefLabel":"Stakeholder"}],"archimate":{"model":"smart-ra 0.3.0-draft.1","basis":"PC-8 role record linked to smart-ra ArchiMate 0.3.0-draft.1 (dth-pc#2, smart-ra#147)","elements":[{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-cc7c864d6daf46e3af08c2b2296221ce.jsonld","name":"User"},{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-bb1fc1b7425444ed8a0c420bec960edd.jsonld","name":"Product Catalog Management System"},{"iri":"https://litlfred.github.io/smart-ra/archima