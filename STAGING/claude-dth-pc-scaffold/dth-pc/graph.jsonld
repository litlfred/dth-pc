r / Distributor"},{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-2bfebc1bb917583cbc21e7d1bfac3164.jsonld","name":"Procurer"},{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-e0e0f3f71f13517aa67f1eee6712a327.jsonld","name":"Donor"},{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-8e67c8e9e1195cdc857b03a2c640e7fe.jsonld","name":"National Regulatory Authority"},{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-22eff58eae365a4f8d0e0368d8c3497e.jsonld","name":"Regulatory Systems"}],"views":[{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/views/id-02175c6feb9155618981ff120f954420.jsonld","name":"National Product Catalogue (DTH PC Fig. 2, Ch. 2-3)"}]}},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-pc/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-pc/blocks/pers-pc-r-01","@type":["smart-base:Persona"],"label":"pers:pc-r-01","kind":"persona","title":"PC-R-01: Data Owner","text":"pers-pc-r-01.md","meta":{"title":"PC-R-01: Data Owner","roleId":"PC-R-01","personaType":"data-governance-role","processes":["PC-BP-02","PC-BP-03"],"responsibilities":["Responsible for the overall strategy, governance, and quality of the Product Master Data.","Defines the rules, policies, and standards for data quality, structure, and governance.","Makes decisions on how the data should be managed and ensures alignment with business objectives.","Approves changes to the Product Master Data and ensures compliance with regulatory and business requirements.","Is accountable for the accuracy, completeness, and relevance of the product data in the organization."],"source":{"library":"9789240116191-eng","section":"page-026","file":"who-iris/library/9789240116191-eng/sections/page-026.md","pdfPage":26,"method":"pc8-role-extraction"},"glossary":[{"iri":"https://litlfred.github.io/dth-pc/v0/ns#glossary/dth-pc/data-owner","prefLabel":"Data Owner"},{"iri":"https://litlfred.github.io/dth-pc/v0/ns#glossary/dth-pc/product-master-data","prefLabel":"Product Master Data"},{"iri":"https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/data-governance","prefLabel":"Data Governance"},{"iri":"https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/stakeholder","prefLabel":"Stakeholder"}],"archimate":{"model":"smart-ra 0.3.0-draft.1","basis":"PC-8 role record linked to smart-ra ArchiMate 0.3.0-draft.1 (dth-pc#2, smart-ra#147)","elements":[{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-b3cf96a0862c5535b607e3feeb3200ae.jsonld","name":"Data Owner"},{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-815bef20a55f5f59b409a76a9a6545f8.jsonld","name":"Product Master Data"},{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-366955c9809942bc8a57d0a77c11d202.jsonld","name":"Product Master Data Management"},{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-d7e3c34b6d185a91844adc02104c5e85.jsonld","name":"Product Master Data Management Roles"}],"views":[{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/views/id-02175c6feb9155618981ff120f954420.jsonld","name":"National Product Catalogue (DTH PC Fig. 2, Ch. 2-3)"}]}},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-pc/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-pc/blocks/pers-pc-r-02","@type":["smart-base:Persona"],"label":"pers:pc-r-02","kind":"persona","title":"PC-R-02: Data Custodian","text":"pers-pc-r-02.md","meta":{"title":"PC-R-02: Data Custodian","roleId":"PC-R-02","personaType":"data-governance-role","processes":["PC-BP-02","PC-BP-03"],"responsibilities":["Responsible for the technical management and security of Product Master Data.","Ensures that the Product Master Data is properly stored, protected, and backed up.","Manages access controls, data migration, and archiving processes.","Implements the rules and standards defined by the Data Owner, ensuring that the data remains secure and operationally available.","Coordinates with IT and other technical teams to ensure the data infrastructure supports business needs."],"source":{"library":"9789240116191-eng","section":"page-026","file":"who-iris/library/9789240116191-eng/sections/page-026.md","pdfPage":26,"method":"pc8-role-extraction"},"glossary":[{"iri":"https://litlfred.github.io/dth-pc/v0/ns#glossary/dth-pc/data-custodian","prefLabel":"Data Custodian"},{"iri":"https://litlfred.github.io/dth-pc/v0/ns#glossary/dth-pc/product-master-data","prefLabel":"Product Master Data"},{"iri":"https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/data-governance","prefLabel":"Data Governance"},{"iri":"https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/stakeholder","prefLabel":"Stakeholder"}],"archimate":{"model":"smart-ra 0.3.0-draft.1","basis":"PC-8 role record linked to smart-ra ArchiMate 0.3.0-draft.1 (dth-pc#2, smart-ra#147)","elements":[{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-06c2566e710852babe841e07e2db92aa.jsonld","name":"Data Custodian"},{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-815bef20a55f5f59b409a76a9a6545f8.jsonld","name":"Product Master Data"},{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-366955c9809942bc8a57d0a77c11d202.jsonld","name":"Product Master Data Management"},{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-d7e3c34b6d185a91844adc02104c5e85.jsonld","name":"Product Master Data Management Roles"}],"views":[{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/views/id-02175c6feb9155618981ff120f954420.jsonld","name":"National Product Catalogue (DTH PC Fig. 2, Ch. 2-3)"}]}},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-pc/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-pc/blocks/pers-pc-r-03","@type":["smart-base:Persona"],"label":"pers:pc-r-03","kind":"persona","title":"PC-R-03: Data Steward","text":"pers-pc-r-03.md","meta":{"title":"PC-R-03: Data Steward","roleId":"PC-R-03","personaType":"data-governance-role","processes":["PC-BP-02","PC-BP-03"],"responsibilities":["Responsible for the day-to-day management, maintenance, and quality control of the Product Master Data.","Ensures that data is accurate, complete, and up to date by monitoring and resolving data quality issues.","Oversees data entry, validation, and correction processes.","Acts as the liaison between business users and technology, facilitating communication about data needs and issues.","Ensures adherence to data governance policies set by the Data Owner."],"source":{"library":"9789240116191-eng","section":"page-026","file":"who-iris/library/9789240116191-eng/sections/page-026.md","pdfPage":26,"method":"pc8-role-extraction"},"glossary":[{"iri":"https://litlfred.github.io/dth-pc/v0/ns#glossary/dth-pc/data-steward","prefLabel":"Data Steward"},{"iri":"https://litlfred.github.io/dth-pc/v0/ns#glossary/dth-pc/product-master-data","prefLabel":"Product Master Data"},{"iri":"https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/data-governance","prefLabel":"Data Governance"},{"iri":"https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/stakeholder","prefLabel":"Stakeholder"}],"archimate":{"model":"smart-ra 0.3.0-draft.1","basis":"PC-8 role record linked to smart-ra ArchiMate 0.3.0-draft.1 (dth-pc#2, smart-ra#147)","elements":[{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-74b14d14e4815abcb7375cd70f3fe9b4.jsonld","name":"Data Steward"},{"iri":"https://litlfred.github.io/smart-ra/archimate/