akeholder"}],"archimate":{"model":"smart-ra 0.3.0-draft.1","basis":"PC-8 role record linked to smart-ra ArchiMate 0.3.0-draft.1 (dth-pc#2, smart-ra#147)","elements":[{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-8e67c8e9e1195cdc857b03a2c640e7fe.jsonld","name":"National Regulatory Authority"},{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-b99b159bb8d558ef8477825142fe4700.jsonld","name":"Regulated Trade Item"},{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-815bef20a55f5f59b409a76a9a6545f8.jsonld","name":"Product Master Data"},{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-22eff58eae365a4f8d0e0368d8c3497e.jsonld","name":"Regulatory Systems"}],"views":[{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/views/id-02175c6feb9155618981ff120f954420.jsonld","name":"National Product Catalogue (DTH PC Fig. 2, Ch. 2-3)"},{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/views/id-053fa0e33f6b5b0bb218195486c05160.jsonld","name":"Product Master Data Information Model (DTH PC Figs. 8-9)"}]}},"provenance":"authored"},{"@context":["https://litlfred.github.io/dth-pc/ns/context/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","smart-base":"https://litlfred.github.io/smart-base/v0/ns#"}],"@id":"papers/dth-pc/blocks/pers-pc-r-07","@type":["smart-base:Persona"],"label":"pers:pc-r-07","kind":"persona","title":"PC-R-07: Manufacturer / Distributor","text":"pers-pc-r-07.md","meta":{"title":"PC-R-07: Manufacturer / Distributor","roleId":"PC-R-07","personaType":"stakeholder-organization","processes":["PC-BP-01","PC-BP-04"],"responsibilities":["Source of truth for Product Master Data; consistently provide Product Master Data in a standardized and uniform format to enable interoperability and barcode scanning (AIDC).","Participate in stakeholder consultation on regulatory policies and guidelines to ensure requirements and phased roll-out timelines are realistic and implementable.","Assign globally unique trade item numbers (GTINs) to Trade Items and submit standardized Product Master Data during regulatory product registration and supply."],"source":{"library":"9789240116191-eng","section":"page-021, page-022, page-023, page-033, page-039","file":"who-iris/library/9789240116191-eng/sections/page-021.md","pdfPage":21,"method":"pc8-role-extraction"},"glossary":[{"iri":"https://litlfred.github.io/dth-pc/v0/ns#glossary/dth-pc/product-master-data","prefLabel":"Product Master Data"},{"iri":"https://litlfred.github.io/dth-pc/v0/ns#glossary/dth-pc/trade-item","prefLabel":"Trade Item"},{"iri":"https://litlfred.github.io/dth-pc/v0/ns#glossary/dth-pc/country-trade-item-identifier","prefLabel":"Country Trade Item Identifier"},{"iri":"https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/stakeholder","prefLabel":"Stakeholder"}],"archimate":{"model":"smart-ra 0.3.0-draft.1","basis":"PC-8 role record linked to smart-ra ArchiMate 0.3.0-draft.1 (dth-pc#2, smart-ra#147)","elements":[{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-66d0f91175c154b48413d57e9f952a34.jsonld","name":"Manufacturer / Distributor"},{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-60e7d1d9e64c5011a1efe8becac406d0.jsonld","name":"Trade Item"},{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-815bef20a55f5f59b409a76a9a6545f8.jsonld","name":"Product Master Data"},{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-e6f60d9b2f6350e1a7622f3e66bc52a2.jsonld","name":"Supply Chain Partners"}],"views":[{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/views/id-02175c6feb9155618981ff120f954420.jsonld","name":"National Product Catalogue (DTH PC Fig. 2, Ch. 2-3)"},{"iri":"https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/views/id-2d524cffba25509e82684f47d624cc42.jsonld","name":"Health Supply